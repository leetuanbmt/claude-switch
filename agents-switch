def _age(ts) -> str:
    if not ts:
        return "?"
    s = max(0, time.time() - ts)
    return "%dm" % (s / 60) if s < 3600 else "%dh" % (s / 3600) if s < 172800 else "%dd" % (s / 86400)


def _resets(u: dict) -> str:
    r = (u.get("seven_day") or {}).get("resets_at")
    try:
        return datetime.fromisoformat(r).astimezone().strftime("%d/%m %H:%M")
    except Exception:
        return ""


def _cursor(visible: bool):
    try:
        curses.curs_set(1 if visible else 0)
    except curses.error:
        pass


def run_quiet(fn, *args, raw=False):
    """Chạy một lệnh mà không in ra console, bắt output trả về cho TUI."""
    buf, good = io.StringIO(), True
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
        try:
            fn(*args)
        except SystemExit as e:
            good = not e.code
        except Exception as e:
            good = False
            print(f"[ERROR] {e}")
    lines = [l.rstrip() for l in buf.getvalue().splitlines()]
    if raw:
        return good, lines
    return good, [re.sub(r"^\[[^\]]*\]\s*", "", l.strip()) for l in lines if l.strip()]


def _ui(scr, client_lock: str = None):
    """Vòng lặp giao diện tương tác Curses đa năng.
    
    Nếu client_lock == 'claude': Giao diện giữ nguyên 100% menu và banner như claude-switch.
    Nếu client_lock == 'codex': Giao diện tối ưu cho Codex.
    Nếu client_lock == None: Cho phép chuyển đổi linh hoạt giữa các client bằng phím Tab hoặc 'c'.
    """
    _cursor(False)
    colors = {k: 0 for k in ("ok", "warn", "bad", "accent")}
    if curses.has_colors() and not os.environ.get("NO_COLOR"):
        curses.start_color()
        curses.use_default_colors()
        for i, (k, col) in enumerate((("ok", curses.COLOR_GREEN), ("warn", curses.COLOR_YELLOW),
                                      ("bad", curses.COLOR_RED), ("accent", curses.COLOR_CYAN)), 1):
            curses.init_pair(i, col, -1)
            colors[k] = curses.color_pair(i)
    else:
        colors["warn"] = colors["bad"] = curses.A_BOLD

    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        curses.mouseinterval(0)
    except curses.error:
        pass

    utf = "utf" in locale.getpreferredencoding(False).lower()
    FULL, EMPTY, DOT, OFF, ARROW, LOGO = (
        ("█", "░", "●", "○", "▸", "⇄") if utf else ("#", "-", "*", "o", ">", "<>"))
    BOLD, DIM, REV = curses.A_BOLD, curses.A_DIM, curses.A_REVERSE

    # Trạng thái hiện tại
    active_cid = client_lock or get_default_client_id()
    client = CLIENTS[active_cid]

    S = {
        "client_id": active_cid,
        "rows": client.load_rows(),
        "sel": 0, "top": 0, "msel": 0, "msg": (True, []),
        "prompt": None, "hits": [], "draw": None
    }

    def switch_client(new_cid: str):
        nonlocal client
        if new_cid in CLIENTS:
            S["client_id"] = new_cid
            client = CLIENTS[new_cid]
            S["rows"] = client.load_rows()
            S["sel"] = 0
            S["msel"] = 0
            S["msg"] = (True, [f"Đã chuyển sang client: {client.NAME}"])

    def get_menu():
        """Tạo danh sách menu phù hợp theo client đang chọn."""
        cid = S["client_id"]
        if client_lock == "claude" or cid == "claude":
            menu = [
                ("1", "Chuyển tài khoản", "chọn profile rồi chuyển", "switch"),
                ("2", "Tài khoản kế tiếp", "chuyển vòng tròn sang profile sau", "next"),
                ("3", "Lưu tài khoản hiện tại", "thành profile mới hoặc cập nhật", "save"),
                ("4", "Quota & usage", "5H / 7 ngày của mọi profile", "usage"),
                ("5", "Đồng bộ session", "gộp sidebar Desktop, chọn từng cái", "sync"),
                ("6", "Xoá profile", "chọn profile cần xoá", "remove"),
                ("7", "Kiểm tra cấu hình", "quyền file, biến ghi đè, profile hỏng", "doctor"),
                ("8", "Trợ giúp", "phím tắt và cách hoạt động", "help"),
            ]
            if not client_lock:
                menu.append(("c", "Đổi client", "chuyển sang OpenAI Codex", "toggle_client"))
            menu.append(("q", "Thoát", "", "quit"))
            return menu
        else:
            # Client: Codex
            menu = [
                ("1", "Chuyển tài khoản", "chọn profile Codex rồi chuyển", "switch"),
                ("2", "Tài khoản kế tiếp", "chuyển vòng tròn sang profile sau", "next"),
                ("3", "Tài khoản trước đó", "chuyển về tài khoản gần nhất (switch -)", "switch_prev"),
                ("4", "Lưu tài khoản hiện tại", "lưu auth.json thành profile", "save"),
                ("5", "Quản lý Alias", "gán hoặc xoá alias tài khoản", "alias"),
                ("6", "Xoá profile", "chọn profile Codex cần xoá", "remove"),
                ("7", "Kiểm tra cấu hình", "kiểm tra quyền file, biến môi trường", "doctor"),
                ("8", "Trợ giúp", "phím tắt và cách hoạt động", "help"),
            ]
            if not client_lock:
                menu.append(("c", "Đổi client", "chuyển sang Claude Code", "toggle_client"))
            menu.append(("q", "Thoát", "", "quit"))
            return menu

    def put(y, x, text, attr=0):
        h, w = scr.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            try:
                scr.addstr(y, x, text[: w - x - (y == h - 1)], attr)
            except curses.error:
                pass

    def fit(text, w):
        return (text if len(text) <= w else text[: w - 1] + "…").ljust(w)

    def rule(y, w):
        put(y, 0, ("─" if utf else "-") * w, DIM)

    def center(y, w, parts):
        x = max(0, (w - sum(len(t) for t, _ in parts)) // 2)
        for t, a in parts:
            put(y, x, t, a)
            x += len(t)

    def quota(u, key):
        p = (u.get(key) or {}).get("utilization")
        if p is None:
            return "?".ljust(11), 0
        n = round(min(p, 100) / 100 * 6)
        attr = colors["ok"] if p < 60 else colors["warn"] if p < 85 else colors["bad"]
        return FULL * n + EMPTY * (6 - n) + " %3d%%" % p, attr

    def frame(min_h=9, min_w=48):
        scr.erase()
        S["hits"] = []
        h, w = scr.getmaxyx()
        if h < min_h or w < min_w:
            put(0, 0, f"Terminal quá nhỏ (cần ≥ {min_w}x{min_h})")
            scr.refresh()
            return None
        return h, w

    def footer(h, hints):
        x = 1
        for key, label, val in hints:
            put(h - 1, x, key, colors["accent"] | BOLD)
            put(h - 1, x + len(key) + 1, label, DIM)
            w = len(key) + 1 + len(label)
            if val is not None:
                S["hits"].append((h - 1, x, x + w, val))
            x += w + 3

    def bottom(h, w, hints):
        rule(h - 4, w)
        cursor = False
        if S["prompt"]:
            text, buf = S["prompt"]
            put(h - 3, 1, text + (buf or ""), colors["warn"] | BOLD)
            if buf is not None:
                scr.move(h - 3, min(w - 1, 1 + len(text) + len(buf)))
                cursor = True
        else:
            good, lines = S["msg"]
            for i, line in enumerate(lines[-2:]):
                mark = ("✔ " if good else "✘ ") if i == 0 and utf else "  "
                put(h - 3 + i, 1, mark + line, colors["ok" if good else "bad"] if i == 0 else DIM)
        footer(h, hints)
        _cursor(cursor)
        scr.refresh()

    def draw_home():
        f = frame(15, 48)
        if not f:
            return
        h, w = f
        rows = S["rows"]
        cur = next((r for r in rows if r["cur"]), None)
        avail = h - 4
        compact = avail < 15
        menu = get_menu()
        total = (1 if compact else 2) + (0 if compact else 1) + (1 if compact else 2) \
            + (0 if compact else 1) + len(menu)
        y = max(0, (avail - total) // 2)

        # Tiêu đề banner: tuỳ theo chế độ claude-switch hay agents-switch
        if client_lock == "claude":
            title = f"{LOGO}  claude-switch"
            subtitle = f"chuyển đổi nhiều tài khoản Claude Code · v{VERSION}"
        elif client_lock == "codex":
            title = f"{LOGO}  codex-switch"
            subtitle = f"chuyển đổi nhiều tài khoản OpenAI Codex · v{VERSION}"
        else:
            title = f"{LOGO}  agents-switch"
            subtitle = f"chuyển đổi tài khoản AI Coding Agents · v{VERSION}"

        center(y, w, [(title, colors["accent"] | BOLD)])
        y += 1
        if not compact:
            center(y, w, [(subtitle, DIM)])
            y += 2

        # Header hiển thị thông tin tài khoản đang active
        cid = S["client_id"]
        if not client_lock:
            client_tag = f"[ Client: {client.NAME} ]  (Tab / c: đổi)"
            center(y - 1, w, [(client_tag, colors["accent"])])

        if cur:
            desc = cur['email']
            if cid == "codex" and cur.get("plan"):
                desc += f"  ({cur['plan']})"
            center(y, w, [(f"{DOT} {cur['name']}", colors["ok"] | BOLD), (f"  ·  {desc}", 0)])
            if not compact and cid == "claude" and cur.get("usage"):
                q5, a5 = quota(cur["usage"], "five_hour")
                q7, a7 = quota(cur["usage"], "seven_day")
                center(y + 1, w, [("5H ", DIM), (q5, a5), ("    7D ", DIM), (q7, a7)])
        else:
            center(y, w, [(f"{OFF} tài khoản đang dùng chưa được lưu hoặc chưa đăng nhập", colors["warn"])])
            if not compact:
                center(y + 1, w, [(f"chọn «Lưu tài khoản hiện tại» để lưu vào profile {client.NAME}", DIM)])

        y += 1 if compact else 3

        mw = min(w - 4, 70)
        x0 = (w - mw) // 2
        for i, (key, label, desc, _) in enumerate(menu):
            yy, sel = y + i, i == S["msel"]
            base = REV if sel else 0
            if sel:
                put(yy, x0, " " * mw, base)
            put(yy, x0 + 1, ARROW if sel else " ", base | colors["accent"])
            put(yy, x0 + 3, key, base | colors["accent"] | BOLD)
            put(yy, x0 + 6, fit(label, 24), base | (BOLD if sel else 0))
            if mw >= 52:
                put(yy, x0 + 31, fit(desc, mw - 32), base | DIM)
            S["hits"].append((yy, x0, x0 + mw, key))

        home_hints = [("↑↓", "chọn", None), ("1-8", "mở nhanh", None), ("⏎", "mở", "\n")]
        if not client_lock:
            home_hints.append(("Tab", "đổi client", "\t"))
        home_hints.extend([("?", "trợ giúp", "?"), ("q", "thoát", "q")])
        bottom(h, w, home_hints)

    def draw_table(mode):
        f = frame()
        if not f:
            return
        h, w = f
        rows = S["rows"]
        cur = next((r for r in rows if r["cur"]), None)
        title_text = {
            "switch": f"Chuyển tài khoản ({client.NAME})",
            "remove": f"Xoá profile ({client.NAME})",
            "usage": f"Quota & usage ({client.NAME})"
        }.get(mode, "Danh sách")
        put(0, 1, title_text, colors["accent"] | BOLD)
        if cur:
            who, attr = f"{DOT} {cur['name']} ", colors["ok"] | BOLD
        else:
            who, attr = f"{OFF} chưa lưu ", colors["warn"]
        put(0, w - len(who), who, attr)
        rule(1, w)

        nw = min(16, max([7] + [len(r["name"]) for r in rows]))
        ew = min(30, max([8] + [len(r["email"]) for r in rows]))

        if S["client_id"] == "claude":
            ow = min(22, max([3] + [len(r.get("org", "")) for r in rows]))
            cols = [["org", ow], ["saved", 5], ["reset", 11]]
            width = lambda: 3 + nw + 1 + ew + 1 + 24 + sum(c + 1 for _, c in cols)
            while cols and width() > w - 1:
                cols.pop(0)
            shown = {k for k, _ in cols}

            x = 3
            for label, cw, on in (("PROFILE", nw, 1), ("EMAIL", ew, 1), ("ORG", ow, "org" in shown),
                                  ("5H", 12, 1), ("7D", 12, 1), ("7D RESET", 11, "reset" in shown),
                                  ("SAVED", 5, "saved" in shown)):
                if on:
                    put(2, x, label, DIM | BOLD)
                    x += cw + 1
        else:
            # Client: Codex
            aw = min(12, max([5] + [len(r.get("alias", "")) for r in rows]))
            pw = min(12, max([4] + [len(r.get("plan", "")) for r in rows]))
            put(2, 3, "PROFILE".ljust(nw), DIM | BOLD)
            put(2, 4 + nw, "ALIAS".ljust(aw), DIM | BOLD)
            put(2, 5 + nw + aw, "EMAIL".ljust(ew), DIM | BOLD)
            put(2, 6 + nw + aw + ew, "PLAN".ljust(pw), DIM | BOLD)

        vis = h - 7
        S["sel"] = max(0, min(S["sel"], len(rows) - 1))
        S["top"] = max(0, min(S["top"], S["sel"]), S["sel"] - vis + 1)
        if not rows:
            put(4, 3, f"Chưa có profile {client.NAME}. Về menu chính → «Lưu tài khoản hiện tại».", DIM)

        for i, r in enumerate(rows[S["top"]: S["top"] + vis]):
            y, sel = 3 + i, S["top"] + i == S["sel"]
            base = REV if sel else 0
            if sel:
                put(y, 0, " " * w, base)
            S["hits"].append((y, 0, w, ("row", S["top"] + i)))
            put(y, 1, ARROW if sel else " ", base | colors["accent"])
            put(y, 2, DOT if r["cur"] else " ", base | colors["ok"])
            x = 3
            put(y, x, fit(r["name"], nw), base | (BOLD if r["cur"] else 0))
            x += nw + 1

            if S["client_id"] == "claude":
                put(y, x, fit(r["email"], ew), base)
                x += ew + 1
                if "org" in shown:
                    put(y, x, fit(r.get("org", ""), ow), base | DIM)
                    x += ow + 1
                for key in ("five_hour", "seven_day"):
                    text, qa = quota(r.get("usage", {}), key)
                    put(y, x, text, base | qa)
                    x += 12
                if "reset" in shown:
                    put(y, x, fit(_resets(r.get("usage", {})), 11), base | DIM)
                    x += 12
                if "saved" in shown:
                    put(y, x, fit("live" if r.get("live") else _age(r.get("saved")), 5), base | DIM)
            else:
                # Codex
                put(y, x, fit(r.get("alias", ""), aw), base | DIM)
                x += aw + 1
                put(y, x, fit(r["email"], ew), base)
                x += ew + 1
                put(y, x, fit(r.get("plan", ""), pw), base | colors["accent"])

        hints = [("↑↓", "chọn", None), ("⏎", "thực hiện", "\n"), ("s", "lưu", "s"),
                 ("d", "xoá", "d"), ("esc", "quay lại", "\x1b")]
        bottom(h, w, hints)

    def getkey():
        while True:
            try:
                k = scr.get_wch()
            except curses.error:
                continue
            if k != curses.KEY_MOUSE:
                return k
            try:
                _, mx, my, _, b = curses.getmouse()
            except curses.error:
                continue
            if b & (curses.BUTTON1_PRESSED | curses.BUTTON1_CLICKED):
                for y, x0, x1, val in S["hits"]:
                    if y == my and x0 <= mx < x1:
                        return val
            elif b & getattr(curses, "BUTTON4_PRESSED", 0):
                return curses.KEY_UP
            elif b & getattr(curses, "BUTTON5_PRESSED", 0):
                return curses.KEY_DOWN

    def confirm(text, keys):
        S["prompt"] = (text, None)
        try:
            while True:
                S["draw"]()
                k = getkey()
                if k == "\x1b":
                    return None
                if isinstance(k, str) and k.lower() in keys:
                    return k.lower()
        finally:
            S["prompt"] = None

    def ask(text):
        buf = ""
        try:
            while True:
                S["prompt"] = (text, buf)
                S["draw"]()
                k = getkey()
                if k == "\x1b":
                    return None
                if k in ("\n", "\r", curses.KEY_ENTER):
                    return buf.strip()
                if k in ("\x7f", "\b", curses.KEY_BACKSPACE):
                    buf = buf[:-1]
                elif isinstance(k, str) and k.isprintable():
                    buf += k
        finally:
            S["prompt"] = None

    def say(good, lines):
        S["msg"] = (good, lines)
        S["rows"] = client.load_rows()

    def do_save() -> bool:
        name = ask("Tên profile (để trống = tự sinh từ email): ")
        if name is None:
            return False
        if name and not NAME_RE.match(name):
            say(False, [f"Tên không hợp lệ: '{name}' (chỉ cho phép chữ, số, . _ -)"])
            return False
        good, lines = run_quiet(client.save, name)
        say(good, lines)
        return good

    def guard() -> bool:
        cid = S["client_id"]
        if cid == "claude":
            if client.current_uuid() and not client.current_profile():
                k = confirm("Tài khoản đang đăng nhập chưa lưu.  [s] lưu rồi chuyển  [c] chuyển luôn  [Esc] huỷ ", "sc")
                if k is None or (k == "s" and not do_save()):
                    return False
        elif cid == "codex":
            if client.auth_file.exists() and not client.current_profile():
                k = confirm("Tài khoản Codex hiện tại chưa lưu.  [s] lưu rồi chuyển  [c] chuyển luôn  [Esc] huỷ ", "sc")
                if k is None or (k == "s" and not do_save()):
                    return False
        return True

    def do_switch(name) -> bool:
        if not guard():
            return False
        say(*run_quiet(client.use, name))
        return True

    def do_remove(name):
        if confirm(f"Xoá profile '{name}'? [y/N] ", "yn") == "y":
            say(*run_quiet(client.remove, name))

    def pick_profile(mode):
        S["sel"] = next((i for i, r in enumerate(S["rows"]) if r["cur"]), 0) if mode == "switch" else 0
        while True:
            S["draw"] = lambda: draw_table(mode)
            S["draw"]()
            k = getkey()
            rows, n = S["rows"], len(S["rows"])
            if isinstance(k, tuple):
                if k[1] != S["sel"]:
                    S["sel"] = k[1]
                    continue
                k = "\n"
            if k in ("q", "\x1b"):
                return
            elif k in (curses.KEY_UP, "k"):
                S["sel"] = max(0, S["sel"] - 1)
            elif k in (curses.KEY_DOWN, "j"):
                S["sel"] = min(n - 1, S["sel"] + 1)
            elif k in ("\n", "\r", curses.KEY_ENTER) and n:
                if mode == "switch" and do_switch(rows[S["sel"]]["name"]):
                    return
                if mode == "remove":
                    do_remove(rows[S["sel"]]["name"])
                    if not S["rows"]:
                        return
            elif k == "s" and mode == "switch":
                do_save()
            elif k == "d" and mode == "switch" and n:
                do_remove(rows[S["sel"]]["name"])

    def show_text(title, lines):
        top = 0
        while True:
            f = frame()
            if f:
                h, w = f
                vis = h - 4
                top = max(0, min(top, len(lines) - vis))
                put(0, 1, title, colors["accent"] | BOLD)
                rule(1, w)
                for i, line in enumerate(lines[top: top + vis]):
                    attr = (colors["ok"] if line.startswith("[OK]") else
                            colors["warn"] if line.startswith("[!]") else
                            colors["bad"] if line.startswith("[ERROR]") else 0)
                    put(2 + i, 2, line, attr)
                rule(h - 2, w)
                footer(h, [("↑↓", "cuộn", None), ("esc", "quay lại", "\x1b")])
                scr.refresh()
            k = getkey()
            if k in ("\x1b", "q", "\n", "\r", curses.KEY_ENTER):
                return
            elif k in (curses.KEY_UP, "k"):
                top = max(0, top - 1)
            elif k in (curses.KEY_DOWN, "j"):
                top += 1

    def do_sessions():
        if S["client_id"] != "claude":
            say(False, ["Đồng bộ session chỉ hỗ trợ cho Claude Code Desktop"])
            return
        got = {}
        good, lines = run_quiet(lambda: got.update(v=client.session_candidates()))
        if not good:
            say(False, lines)
            return
        dst, cands = got["v"]
        items = [c for c in cands if c["dst_ts"] is None]
        if not items:
            say(True, ["Không có session nào cần gộp"])
            return
        chosen, cur_i, top = set(), 0, 0
        while True:
            f = frame()
            if f:
                h, w = f
                vis = max(1, h - 4)
                top = max(0, min(top, cur_i), cur_i - vis + 1)
                count = f"{len(chosen)}/{len(items)} đã chọn"
                put(0, 1, "Đồng bộ session về tài khoản đang dùng", colors["accent"] | BOLD)
                put(0, max(0, w - len(count) - 1), count, DIM)
                rule(1, w)
                tw = max(10, w - 40)
                for i, c in enumerate(items[top: top + vis]):
                    idx = top + i
                    base = REV if idx == cur_i else 0
                    if base:
                        put(2 + i, 0, " " * w, base)
                    S["hits"].append((2 + i, 0, w, ("row", idx)))
                    put(2 + i, 1, ("[x] " if idx in chosen else "[ ] ") + "%-5s" % _age(c["ts"]),
                        base | (colors["ok"] if idx in chosen else 0))
                    put(2 + i, 12, fit(c["title"], tw), base)
                    put(2 + i, 13 + tw, fit(c["src"], 14), base | DIM)
                rule(h - 2, w)
                footer(h, [("↑↓", "chọn", None), ("space", "đánh dấu", " "), ("a", "tất cả", "a"),
                           ("⏎", "gộp", "\n"), ("esc", "quay lại", "\x1b")])
                scr.refresh()
            k = getkey()
            if isinstance(k, tuple):
                cur_i = k[1]
                k = " "
            if k in ("\x1b", "q"):
                return
            elif k in (curses.KEY_UP, "k"):
                cur_i = max(0, cur_i - 1)
            elif k in (curses.KEY_DOWN, "j"):
                cur_i = min(len(items) - 1, cur_i + 1)
            elif k == " ":
                chosen ^= {cur_i}
            elif k == "a":
                chosen = set() if len(chosen) == len(items) else set(range(len(items)))
            elif k in ("\n", "\r", curses.KEY_ENTER):
                plan = [("copy", items[i]) for i in sorted(chosen or {cur_i})]
                say(*run_quiet(apply_sync, plan, dst))
                return

    def do_alias_manager():
        """Quản lý alias cho tài khoản Codex."""
        target = ask("Tên profile hoặc email cần gán alias: ")
        if not target:
            return
        new_alias = ask("Nhập alias mới (để trống để xoá alias): ")
        if new_alias is None:
            return
        if new_alias:
            good, lines = run_quiet(client.alias_set, target, new_alias)
        else:
            good, lines = run_quiet(client.alias_clear, target)
        say(good, lines)

    help_lines = [
        "Điều hướng và phím tắt:",
        "  ↑ ↓ / j k     chọn mục                Enter   mở / xác nhận",
        "  Tab / c       đổi giữa Claude và Codex (trong agents-switch)",
        "  1-8           mở mục theo số          Esc     quay lại (ở menu chính: thoát)",
        "  chuột         bấm vào mục hoặc gợi ý phím ở chân màn hình; cuộn bằng bánh xe",
        "",
        "Trong danh sách profile:  Enter chuyển · d xoá · s lưu tài khoản hiện tại",
        "Trong danh sách session:  Space đánh dấu · a chọn tất cả · Enter gộp",
        "",
        "Đối với Claude: Quota đọc từ ~/.claude.json, hỗ trợ gộp session Desktop.",
        "Đối với Codex:  Tham khảo từ codex-auth, quản lý auth.json, hỗ trợ switch -",
        "Sau khi chuyển đổi tài khoản, vui lòng khởi động lại client để nhận token mới.",
    ]

    def act(action) -> bool:
        if action == "quit":
            return True
        S["msg"] = (True, [])
        if action in ("switch", "usage", "remove"):
            pick_profile(action)
        elif action == "next":
            if guard():
                say(*run_quiet(client.next))
        elif action == "switch_prev":
            if guard():
                say(*run_quiet(client.switch_prev))
        elif action == "save":
            do_save()
        elif action == "alias":
            do_alias_manager()
        elif action == "sync":
            do_sessions()
        elif action == "doctor":
            show_text(f"Kiểm tra cấu hình ({client.NAME})", run_quiet(client.doctor, raw=True)[1])
        elif action == "help":
            show_text("Trợ giúp", help_lines)
        elif action == "toggle_client":
            next_cid = "codex" if S["client_id"] == "claude" else "claude"
            switch_client(next_cid)
        S["rows"] = client.load_rows()
        return False

    while True:
        S["draw"] = draw_home
        draw_home()
        k = getkey()
        menu = get_menu()
        if k in ("q", "\x1b"):
            return
        elif k in (curses.KEY_UP, "k"):
            S["msel"] = (S["msel"] - 1) % len(menu)
        elif k in (curses.KEY_DOWN, "j"):
            S["msel"] = (S["msel"] + 1) % len(menu)
        elif k == "\t":
            if not client_lock:
                next_cid = "codex" if S["client_id"] == "claude" else "claude"
                switch_client(next_cid)
        elif k == "?":
            act("help")
        elif k in ("\n", "\r", curses.KEY_ENTER):
            if act(menu[S["msel"]][3]):
                return
        elif isinstance(k, str) and k in [m[0] for m in menu]:
            idx = [m[0] for m in menu].index(k)
            S["msel"] = idx
            if act(menu[idx][3]):
                return


def start_ui(client_lock: str = None):
    """Khởi động TUI, kiểm tra môi trường terminal trước."""
    if curses is None:
        die("TUI cần module curses (Windows chưa hỗ trợ). Dùng lệnh CLI: agents-switch help")
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("TUI cần terminal tương tác. Dùng lệnh CLI: agents-switch help")
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda scr: _ui(scr, client_lock))
    except KeyboardInterrupt:
        pass


