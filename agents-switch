# Biểu thức chính quy kiểm tra tên profile hợp lệ, chống tấn công path traversal (../../etc/passwd)
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

# Đọc phiên bản từ file VERSION nằm cạnh script trong repo
VERSION_FILE = Path(__file__).resolve().parent / "VERSION"
