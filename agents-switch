def dispatch_claude(c: ClaudeClient, cmd: str, args: list, arg: str):
    """Phân phối lệnh cho client Claude Code."""
    if cmd == "ui":
        start_ui("claude")
    elif cmd == "save":
        with c.lock():
            c.save(arg)
    elif cmd in ("use", "switch"):
        with c.lock():
            if arg == "-":
                c.switch_prev()
            elif not arg:
                if sys.stdin.isatty() and sys.stdout.isatty() and curses:
                    start_ui("claude")
                else:
                    die("Usage: claude-switch switch <name|email>")
            else:
                c.use(arg)
    elif cmd == "-":
        with c.lock():
            c.switch_prev()
    elif cmd in ("list", "ls"):
        c.list()
    elif cmd in ("status", "current"):
        c.status()
    elif cmd == "usage":
        c.usage()
    elif cmd == "doctor":
        c.doctor()
    elif cmd == "next":
        with c.lock():
            c.next()
    elif cmd in ("remove", "rm"):
        with c.lock():
            if not arg:
                die("Usage: claude-switch remove <name>")
            for a in args:
                c.remove(a)
    elif cmd == "sync-sessions":
        c.sync_sessions(args)
    elif cmd in ("version", "-v", "--version"):
        print(VERSION)
    elif cmd in ("help", "-h", "--help"):
        print_claude_help()
    else:
        with c.lock():
            c.use(cmd)


def dispatch_codex(c: CodexClient, cmd: str, args: list, arg: str):
    """Phân phối lệnh cho client OpenAI Codex."""
    if cmd == "ui":
        start_ui("codex")
    elif cmd == "save":
        with c.lock():
            c.save(arg)
    elif cmd in ("use", "switch"):
        with c.lock():
            if arg == "-":
                c.switch_prev()
            elif not arg:
                if sys.stdin.isatty() and sys.stdout.isatty() and curses:
                    start_ui("codex")
                else:
                    die("Usage: codex-switch switch <name|alias|email>")
            else:
                c.use(arg)
    elif cmd == "-":
        with c.lock():
            c.switch_prev()
    elif cmd in ("list", "ls"):
        c.list()
    elif cmd in ("status", "current"):
        c.status()
    elif cmd == "next":
        with c.lock():
            c.next()
    elif cmd in ("remove", "rm"):
        with c.lock():
            all_flag = "--all" in args
            filtered_args = [a for a in args if a != "--all"]
            if not filtered_args and not all_flag:
                die("Usage: codex-switch remove <name|alias|email>... hoặc codex-switch remove --all")
            c.remove(*filtered_args, all_profiles=all_flag)
    elif cmd == "alias":
        with c.lock():
            sub = args[0] if args else ""
            if sub == "set" and len(args) >= 3:
                c.alias_set(args[1], args[2])
            elif sub == "clear" and len(args) >= 2:
                c.alias_clear(args[1])
            elif sub in ("", "list"):
                c.list()
            else:
                die("Usage: codex-switch alias set <query> <alias> | codex-switch alias clear <query>")
    elif cmd == "login":
        device_auth = "--device-auth" in args
        with c.lock():
            c.login(device_auth=device_auth)
    elif cmd == "export":
        c.export(arg if arg and not arg.startswith("-") else "")
    elif cmd == "import":
        with c.lock():
            c.import_auth(arg)
    elif cmd == "doctor":
        c.doctor()
    elif cmd in ("version", "-v", "--version"):
        print(VERSION)
    elif cmd in ("help", "-h", "--help"):
        print_codex_help()
    else:
        with c.lock():
            c.use(cmd)


def main():
    """Hàm khởi động chính của agents-switch.
    
    Phát hiện chế độ hoạt động:
    - Nếu chạy qua symlink/lệnh 'claude-switch': khoá sang Claude Code mode.
    - Nếu chạy qua symlink/lệnh 'codex-switch': khoá sang Codex mode.
    - Nếu chạy qua 'agents-switch':
      - Kiểm tra cờ --client/-c hoặc tham số đầu là tên client ('claude', 'codex') -> chuyển vào client đó.
      - Nếu là lệnh toàn cục ('clients', 'client', 'status', 'doctor') -> xử lý toàn cục.
      - Nếu không có tham số: mở TUI đa client nếu có TTY, hoặc in help nếu qua pipe/script.
    """
    invoked_name = Path(sys.argv[0]).name

    # 1. Chế độ tương thích claude-switch
    if invoked_name == "claude-switch" or os.environ.get("AGENTS_SWITCH_MODE") == "claude":
        claude_client = CLIENTS["claude"]
        claude_client.ensure_dirs()
        argv = sys.argv[1:] or (["ui"] if sys.stdin.isatty() and sys.stdout.isatty() and curses else ["help"])
        cmd, args = argv[0], argv[1:]
        arg = args[0] if args else ""
        dispatch_claude(claude_client, cmd, args, arg)
        return

    # 2. Chế độ tương thích codex-switch
    if invoked_name in ("codex-switch", "codex-auth") or os.environ.get("AGENTS_SWITCH_MODE") == "codex":
        codex_client = CLIENTS["codex"]
        codex_client.ensure_dirs()
        argv = sys.argv[1:] or (["ui"] if sys.stdin.isatty() and sys.stdout.isatty() and curses else ["help"])
        cmd, args = argv[0], argv[1:]
        arg = args[0] if args else ""
        dispatch_codex(codex_client, cmd, args, arg)
        return

    # 3. Chế độ chính: agents-switch (Multi-Client)
    CLIENTS["claude"].ensure_dirs()
    CLIENTS["codex"].ensure_dirs()
    AGENTS_DIR.mkdir(parents=True, exist_ok=True)

    argv = sys.argv[1:]
    if not argv:
        if sys.stdin.isatty() and sys.stdout.isatty() and curses:
            start_ui()
        else:
            print_agents_help()
        return

    first_arg = argv[0]

    # Hỗ trợ cờ --client <id> hoặc -c <id>
    if first_arg in ("--client", "-c") and len(argv) >= 2:
        target_client = argv[1]
        if target_client not in CLIENTS:
            die(f"Client '{target_client}' không được hỗ trợ. Khả dụng: {', '.join(CLIENTS.keys())}")
        c = CLIENTS[target_client]
        sub_argv = argv[2:] or ["help"]
        cmd, args = sub_argv[0], sub_argv[1:]
        arg = args[0] if args else ""
        if target_client == "claude":
            dispatch_claude(c, cmd, args, arg)
        else:
            dispatch_codex(c, cmd, args, arg)
        return

    # Kiểm tra nếu chỉ định client cụ thể: `agents-switch claude <cmd>` hoặc `agents-switch codex <cmd>`
    if first_arg in CLIENTS:
        client_id = first_arg
        c = CLIENTS[client_id]
        sub_argv = argv[1:] or ["help"]
        cmd, args = sub_argv[0], sub_argv[1:]
        arg = args[0] if args else ""
        if client_id == "claude":
            dispatch_claude(c, cmd, args, arg)
        else:
            dispatch_codex(c, cmd, args, arg)
        return

    # Các lệnh toàn cục của agents-switch
    if first_arg == "ui":
        start_ui()
    elif first_arg in ("clients", "--clients"):
        cmd_clients()
    elif first_arg == "client":
        if len(argv) >= 2:
            set_default_client_id(argv[1])
        else:
            print(f"Client mặc định hiện tại: {get_default_client_id()}")
    elif first_arg in ("status", "current"):
        cmd_status_all()
    elif first_arg == "doctor":
        cmd_doctor_all()
    elif first_arg in ("version", "-v", "--version"):
        print(VERSION)
    elif first_arg in ("help", "-h", "--help"):
        print_agents_help()
    else:
        # Chuyển tiếp tới client mặc định
        def_id = get_default_client_id()
        c = CLIENTS[def_id]
        cmd, args = first_arg, argv[1:]
        arg = args[0] if args else ""
        if def_id == "claude":
            dispatch_claude(c, cmd, args, arg)
        else:
            dispatch_codex(c, cmd, args, arg)


if __name__ == "__main__":
    main()
