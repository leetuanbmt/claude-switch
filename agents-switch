def die(msg: str):
    """In thông báo lỗi ra stderr và dừng chương trình với mã thoát 1."""
    print(f"[ERROR] {msg}", file=sys.stderr)
    sys.exit(1)


def ok(msg: str):
    """In thông báo thành công ra stdout."""
    print(f"[OK] {msg}")


def write_json(path: Path, data):
    """Ghi dữ liệu JSON an toàn (atomic write) với chmod 600.
    
    Tạo file tạm đuôi .tmp trước, ghi nội dung JSON, rồi dùng os.replace để hoán đổi.
    Tránh tình trạng file bị hỏng nếu tiến trình bị ngắt đột ngột (kill, mất điện).
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def load_json(path: Path) -> dict:
    """Đọc dữ liệu từ file JSON, trả về dict rỗng nếu file không tồn tại hoặc lỗi cú pháp."""
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def parse_jwt_payload(token: str) -> dict:
    """Giải mã payload của token JWT (JSON Web Token) mà không cần thư viện bên ngoài.
    
    JWT gồm 3 phần phân tách bởi dấu chấm: header.payload.signature.
    Phần payload được mã hoá Base64URL. Hàm thêm padding '=' hợp lệ và giải mã JSON.
    Trả về dict rỗng nếu token không hợp lệ.
    """
    if not token or not isinstance(token, str):
        return {}
    parts = token.strip().split(".")
    if len(parts) < 2:
        return {}
    payload_b64 = parts[1]
    # Bổ sung padding cho độ dài chia hết cho 4 theo quy tắc Base64
    payload_b64 += "=" * ((4 - len(payload_b64) % 4) % 4)
    try:
        decoded_bytes = base64.urlsafe_b64decode(payload_b64.encode("utf-8"))
        return json.loads(decoded_bytes.decode("utf-8", errors="replace"))
    except Exception:
        return {}


def process_count(name: str) -> int:
    """Đếm số tiến trình đang chạy theo tên (dùng pgrep). Trả về 0 nếu không tìm thấy."""
    try:
        r = subprocess.run(["pgrep", "-x", name], capture_output=True, text=True)
        return len(r.stdout.split()) if r.returncode == 0 else 0
    except OSError:
        return 0


