class ClaudeClient:
    """Quản lý tài khoản cho Claude Code CLI và Claude Desktop."""

    ID = "claude"
    NAME = "Claude Code"

    def __init__(self):
        self.acc_dir = HOME / ".claude-accounts"
        self.backup_dir = self.acc_dir / "backups"
        self.state_file = self.acc_dir / ".last"
        self.prev_file = self.acc_dir / ".previous"
        self.config_file = HOME / ".claude.json"
        self.creds_file = HOME / ".claude" / ".credentials.json"
        self.kc_service = "Claude Code-credentials"

    def ensure_dirs(self):
        """Khởi tạo các thư mục lưu trữ profile và bản sao lưu với quyền bảo mật 700."""
        self.acc_dir.mkdir(parents=True, exist_ok=True)
        self.backup_dir.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(self.acc_dir, 0o700)
            os.chmod(self.backup_dir, 0o700)
        except OSError:
            pass

    def sessions_dir(self) -> Path:
        """Đường dẫn thư mục phiên làm việc của Claude Desktop."""
        override = os.environ.get("CLAUDE_SESSIONS_DIR")
        if override:
            return Path(override)
        if sys.platform == "darwin":
            return HOME / "Library/Application Support/Claude/claude-code-sessions"
        if os.name == "nt":
            base = Path(os.environ.get("APPDATA") or HOME / "AppData/Roaming")
            return base / "Claude/claude-code-sessions"
        base = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
        return base / "Claude/claude-code-sessions"

    def profile_path(self, name: str) -> Path:
        """Đường dẫn file profile từ tên, kiểm tra chống path traversal."""
        if not NAME_RE.match(name or ""):
            die(f"Tên không hợp lệ: '{name}' (chỉ cho phép chữ, số, . _ -)")
        return self.acc_dir / f"{name}.json"

    def profile_names(self) -> list:
        """Danh sách tên các profile Claude Code đã lưu theo thứ tự alphabet."""
        if not self.acc_dir.exists():
            return []
        return sorted(
            p.stem for p in self.acc_dir.glob("*.json") if not p.name.startswith(".")
        )

    def use_file_backend(self) -> bool:
        """Xác định dùng file credentials hay Keychain (file được ưu tiên nếu đã tồn tại hoặc không phải macOS)."""
        return self.creds_file.exists() or sys.platform != "darwin"

    def read_creds(self) -> str:
        """Đọc credential hiện tại từ file hoặc macOS Keychain."""
        if self.use_file_backend():
            return self.creds_file.read_text() if self.creds_file.exists() else ""
        r = subprocess.run(
            ["security", "find-generic-password", "-a", os.environ.get("USER", ""),
             "-s", self.kc_service, "-w"],
            capture_output=True, text=True,
        )
        return r.stdout.strip() if r.returncode == 0 else ""

    def write_creds(self, blob: str):
        """Ghi credential vào file (~/.claude/.credentials.json) hoặc Keychain."""
        if not blob:
            die("credential rỗng, không ghi")
        if self.use_file_backend():
            self.creds_file.parent.mkdir(parents=True, exist_ok=True)
            self.creds_file.write_text(blob)
            os.chmod(self.creds_file, 0o600)
            return
        r = subprocess.run(
            ["security", "add-generic-password", "-U", "-a", os.environ.get("USER", ""),
             "-s", self.kc_service, "-w", blob],
            capture_output=True,
        )
        if r.returncode != 0:
            die("không ghi được Keychain")

    def load_config(self) -> dict:
        """Đọc cấu hình ~/.claude.json."""
        return load_json(self.config_file)

    def current_uuid(self) -> str:
        """UUID của tài khoản Claude Code đang đăng nhập."""
        return self.load_config().get("oauthAccount", {}).get("accountUuid") or ""

    def current_org(self) -> str:
        """UUID của organization đang hoạt động trong Claude Code."""
        return self.load_config().get("oauthAccount", {}).get("organizationUuid") or ""

    def current_profile(self) -> str:
        """Tìm tên profile trùng khớp với accountUuid đang active."""
        uuid = self.current_uuid()
        if not uuid:
            return ""
        for name in self.profile_names():
            prof = load_json(self.acc_dir / f"{name}.json")
            if prof.get("oauthAccount", {}).get("accountUuid") == uuid:
                return name
        return ""

    @contextlib.contextmanager
    def lock(self):
        """Đảm bảo chỉ một tiến trình ghi dữ liệu profile Claude tại một thời điểm."""
        self.ensure_dirs()
        if fcntl is None:
            yield
            return
        lock_file = self.acc_dir / ".lock"
        with open(lock_file, "w") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                die("đang có lệnh claude-switch khác chạy — thử lại sau vài giây")
            yield

    def backup_config(self):
        """Giữ tối đa 10 bản sao lưu gần nhất của ~/.claude.json trước khi ghi đè."""
        if not self.config_file.exists():
            return
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        shutil.copy(self.config_file, self.backup_dir / f"claude.json.{stamp}.{os.getpid()}")
        old = sorted(self.backup_dir.glob("claude.json.*"), key=lambda p: p.stat().st_mtime)
        for p in old[:-10]:
            try:
                p.unlink()
            except OSError:
                pass

    def name_from_email(self, cfg: dict) -> str:
        """Trích xuất tên gợi ý từ email (lấy phần trước dấu @)."""
        email = cfg.get("oauthAccount", {}).get("emailAddress", "")
        return re.sub(r"[^A-Za-z0-9._-]", "-", email.split("@")[0]) if email else ""

    def save(self, name: str = "", quiet: bool = False):
        """Lưu trạng thái đăng nhập hiện tại thành một profile Claude Code."""
        creds = self.read_creds()
        if not creds:
            die("chưa đăng nhập (không tìm thấy credential). Chạy `claude` và đăng nhập trước.")
        if not self.config_file.exists():
            die(f"không tìm thấy {self.config_file}")
        cfg = self.load_config()

        if not name:
            name = self.name_from_email(cfg)
            if not name:
                die("không suy ra được tên từ email, truyền tên: claude-switch save <name>")

        out = self.profile_path(name)
        try:
            creds_data = json.loads(creds)
        except Exception:
            creds_data = creds

        write_json(out, {
            "credentials": creds_data,
            "oauthAccount": cfg.get("oauthAccount", {}),
            "userID": cfg.get("userID"),
            "usage": cfg.get("cachedUsageUtilization"),
            "savedAt": int(time.time()),
        })
        if not quiet:
            ok(f"Đã lưu profile '{name}'")

    def resolve_profile_name(self, query: str) -> str:
        """Tìm tên profile Claude khớp với truy vấn: tên, số hàng (1-indexed), hoặc email.
        
        Quy tắc:
        1. Khớp chính xác tên profile hợp lệ (nếu query là tên hợp lệ và file tồn tại).
        2. Khớp số thứ tự hàng hiển thị (1, 2, ...).
        3. Khớp chính xác email trong cấu hình profile.
        4. Khớp tiền tố hoặc chuỗi con (tên hoặc email).
        """
        if not query:
            return ""
        names = self.profile_names()
        if not names:
            return ""

        # 1. Khớp chính xác tên profile hợp lệ
        if NAME_RE.match(query) and self.profile_path(query).exists():
            return query

        # 2. Khớp số thứ tự hàng (1-indexed row number)
        if query.isdigit():
            idx = int(query)
            if 1 <= idx <= len(names):
                return names[idx - 1]

        q_lower = query.lower()
        profiles = []
        for name in names:
            p = load_json(self.profile_path(name))
            if p:
                profiles.append((name, p))

        # 3. Khớp chính xác email
        for name, p in profiles:
            email = p.get("oauthAccount", {}).get("emailAddress", "").lower()
            if email == q_lower:
                return name

        # 4. Khớp tiền tố hoặc chuỗi con
        for name, p in profiles:
            if name.lower().startswith(q_lower):
                return name
            email = p.get("oauthAccount", {}).get("emailAddress", "").lower()
            if email and (email.startswith(q_lower) or q_lower in email):
                return name

        return ""

    def use(self, query: str):
        """Chuyển sang profile Claude Code được chỉ định (hỗ trợ tên, số hàng, email)."""
        if not query:
            die("Usage: claude-switch switch <name|email>")
        name = self.resolve_profile_name(query)
        if not name:
            die(f"không có profile '{query}'. Xem: claude-switch list")
        src = self.profile_path(name)
        prof = load_json(src)

        cur = self.current_profile()
        if cur and cur != name:
            self.save(cur, quiet=True)
            print(f"[..] Đã cập nhật profile hiện tại: {cur}")
            self.prev_file.write_text(cur)
        elif not cur and self.current_uuid():
            print("[!] Tài khoản đang đăng nhập chưa được lưu — sẽ mất truy cập nhanh tới nó.\n"
                  "    Huỷ (Ctrl-C) rồi chạy: claude-switch save <name>")

        self.backup_config()
        cfg = self.load_config()
        cfg["oauthAccount"] = prof.get("oauthAccount", {})
        cfg["userID"] = prof.get("userID")
        cfg.pop("cachedUsageUtilization", None)
        write_json(self.config_file, cfg)

        creds = prof.get("credentials")
        self.write_creds(json.dumps(creds) if isinstance(creds, dict) else str(creds))
        self.state_file.write_text(name)
        ok(f"Đã chuyển sang '{name}'")
        n = process_count("claude")
        print(f"    Đang có {n} tiến trình claude chạy bằng token cũ — thoát hẳn rồi mở lại." if n
              else "    Mở Claude Code để dùng tài khoản mới.")

    def switch_prev(self):
        """Chuyển đổi về tài khoản Claude Code trước đó (tương tự 'switch -' trong codex-auth)."""
        if not self.prev_file.exists():
            die("Chưa ghi nhận tài khoản trước đó để chuyển")
        prev = self.prev_file.read_text().strip()
        if not prev or not self.profile_path(prev).exists():
            die(f"Tài khoản trước đó '{prev}' không còn tồn tại")
        self.use(prev)

    def next(self):
        """Chuyển sang profile Claude Code tiếp theo theo vòng tròn alphabet."""
        names = self.profile_names()
        if not names:
            die("chưa có profile nào")
        last = self.current_profile() or (self.state_file.read_text().strip() if self.state_file.exists() else "")
        idx = names.index(last) if last in names else -1
        self.use(names[(idx + 1) % len(names)])

    def remove(self, query: str):
        """Xoá bỏ một profile Claude Code và dọn dẹp liên kết trạng thái cũ."""
        if not query:
            die("Usage: claude-switch remove <name>")
        name = self.resolve_profile_name(query)
        if not name:
            die(f"không có profile '{query}'")
        f = self.profile_path(name)
        f.unlink(missing_ok=True)
        if self.prev_file.exists() and self.prev_file.read_text().strip() == name:
            self.prev_file.unlink(missing_ok=True)
        if self.state_file.exists() and self.state_file.read_text().strip() == name:
            self.state_file.unlink(missing_ok=True)
        ok(f"Đã xoá profile '{name}' (tài khoản trên server không bị ảnh hưởng)")

    def load_rows(self) -> list:
        """Nạp danh sách các profile Claude kèm trạng thái và thông số quota."""
        cur = self.current_profile()
        live = self.load_config().get("cachedUsageUtilization")
        rows = []
        for n in self.profile_names():
            p = load_json(self.acc_dir / f"{n}.json")
            if not p:
                continue
            usage, saved = p.get("usage"), p.get("savedAt")
            is_live = n == cur and bool(live)
            if is_live:
                usage = live
            a = p.get("oauthAccount", {})
            rows.append({
                "name": n,
                "cur": n == cur,
                "email": a.get("emailAddress", "?"),
                "org": a.get("organizationName") or a.get("billingType") or "",
                "usage": (usage or {}).get("utilization") or {},
                "saved": saved,
                "live": is_live,
            })
        return rows

    def list(self):
        """In danh sách các profile Claude Code."""
        rows = self.load_rows()
        if not rows:
            print("Chưa có profile nào. Lưu tài khoản hiện tại: claude-switch save <name>")
            return
        for r in rows:
            print("%s %-14s %-32s %s" % ("*" if r["cur"] else " ", r["name"], r["email"], r["org"]))

    def status(self):
        """In trạng thái tài khoản Claude Code đang active kèm thông tin email."""
        cur = self.current_profile()
        cfg = self.load_config()
        email = cfg.get("oauthAccount", {}).get("emailAddress", "")
        if cur:
            detail = f" · {email}" if email else ""
            ok(f"Đang dùng: {cur}{detail}")
        elif self.current_uuid():
            detail = f": {email}" if email else ""
            print(f"[?] Đang đăng nhập một tài khoản chưa được lưu thành profile{detail}")
        else:
            print("[?] Chưa đăng nhập")

    def usage(self):
        """Hiển thị bảng Quota 5h / 7 ngày của các profile Claude Code."""
        rows = self.load_rows()
        if not rows:
            print("Chưa có profile nào.")
            return

        def pct(u, key):
            b = u.get(key)
            if not b:
                return "  ?  ", ""
            resets = b.get("resets_at") or ""
            if resets:
                try:
                    resets = "reset " + datetime.fromisoformat(resets).astimezone().strftime("%d/%m %H:%M")
                except Exception:
                    pass
            return "%3d%%" % b.get("utilization", 0), resets

        print("%-14s %-28s %-6s %-6s %-6s %s" % ("PROFILE", "EMAIL", "5H", "7D", "NGUỒN", ""))
        for r in rows:
            h5, _ = pct(r["usage"], "five_hour")
            d7, r7 = pct(r["usage"], "seven_day")
            print("%-14s %-28s %-6s %-6s %-6s %s" % (
                r["name"], r["email"], h5, d7, "live" if r["live"] else _age(r["saved"]), r7))
        print("\nlive = tài khoản đang dùng, đọc từ ~/.claude.json. Còn lại là snapshot lúc profile")
        print("được lưu (tự cập nhật mỗi lần switch). Số realtime: claude  →  /usage")

    def doctor(self):
        """Kiểm tra sức khoẻ cấu hình, quyền hạn và tính toàn vẹn của Claude Code."""
        bad = 0

        def line(level, msg):
            nonlocal bad
            print({"ok": "[OK]   ", "warn": "[!]    ", "err": "[ERROR]"}[level], msg)
            bad += level == "err"

        for v in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN"):
            if os.environ.get(v):
                line("warn", f"biến {v} đang đặt — nó ưu tiên hơn credential đã đăng nhập, "
                             "nên switch không có tác dụng trong shell này")
        line("ok", "credential: " + ("file " + str(self.creds_file) if self.use_file_backend() else "macOS Keychain"))
        if not self.read_creds():
            line("warn", "chưa đăng nhập (không có credential)")
        if self.acc_dir.exists() and (self.acc_dir.stat().st_mode & 0o077):
            line("err", f"{self.acc_dir} cho phép nhóm/người khác truy cập — chạy: chmod 700 {self.acc_dir}")

        uuids = {}
        for n in self.profile_names():
            f = self.acc_dir / f"{n}.json"
            if f.stat().st_mode & 0o077:
                line("err", f"profile '{n}' chứa refresh token nhưng không phải chmod 600")
            try:
                p = json.loads(f.read_text())
                u = p["oauthAccount"]["accountUuid"]
                assert p["credentials"] and p["userID"]
            except Exception:
                line("err", f"profile '{n}' hỏng hoặc thiếu trường — lưu lại: claude-switch save {n}")
                continue
            uuids.setdefault(u, []).append(n)
        for names in uuids.values():
            if len(names) > 1:
                line("warn", f"các profile {', '.join(names)} là cùng một tài khoản")
        if self.current_uuid() and not self.current_profile():
            line("warn", "tài khoản đang đăng nhập chưa được lưu thành profile")
        n = process_count("claude")
        if n:
            line("ok", f"{n} tiến trình claude đang chạy (giữ token cũ nếu bạn vừa switch)")
        s_dir = self.sessions_dir()
        line("ok" if s_dir.is_dir() else "warn",
             f"Claude Desktop sessions: {s_dir}" + ("" if s_dir.is_dir() else " (chưa có — bỏ qua nếu không dùng Desktop)"))
        print("\nKhông phát hiện lỗi." if not bad else f"\n{bad} lỗi cần sửa.")
        sys.exit(1 if bad else 0)

    # --- Đồng bộ session Claude Desktop ---
    def account_labels(self) -> dict:
        out = {}
        for n in self.profile_names():
            try:
                p = load_json(self.acc_dir / f"{n}.json")
                out[p["oauthAccount"]["accountUuid"]] = n
            except Exception:
                pass
        return out

    def session_candidates(self):
        uuid, org = self.current_uuid(), self.current_org()
        if not uuid or not org:
            die("chưa đăng nhập, không biết gộp về đâu")
        s_dir = self.sessions_dir()
        if not s_dir.is_dir():
            die(f"không có {s_dir} — Claude Desktop chưa chạy lần nào? "
                "Đường dẫn khác thì đặt CLAUDE_SESSIONS_DIR")
        dst, labels, out = s_dir / uuid / org, self.account_labels(), []
        for src in sorted(s_dir.glob("*/*")):
            if not src.is_dir() or src == dst:
                continue
            for f in sorted(src.glob("local_*.json")):
                meta = load_json(f)
                d = dst / f.name
                out.append({
                    "path": f, "name": f.name, "src_uuid": src.parent.name,
                    "src": labels.get(src.parent.name, src.parent.name[:8]),
                    "ids": [f.stem, meta.get("cliSessionId") or ""],
                    "title": meta.get("title") or "(không tên)", "cwd": meta.get("cwd") or "",
                    "ts": _sess_ts(f, meta),
                    "dst_ts": _sess_ts(d, load_json(d)) if d.exists() else None,
                })
        out.sort(key=lambda x: -x["ts"])
        return dst, out

    def sync_sessions(self, args=()):
        opt = {"apply": False, "update": False, "from": "", "ids": []}
        it = iter(args)
        for a in it:
            if a in ("--apply", "--update"):
                opt[a[2:]] = True
            elif a in ("--from", "--session"):
                v = next(it, "")
                if not v:
                    die(f"{a} cần một giá trị. Xem: claude-switch help")
                if a == "--from":
                    opt["from"] = v
                else:
                    opt["ids"].append(v)
            else:
                die(f"tuỳ chọn không hợp lệ: {a}. Xem: claude-switch help")

        dst, cands = self.session_candidates()
        plan = plan_sync(cands, opt["from"], opt["ids"], opt["update"])
        marks = {"copy": "+", "update": "~", "skip": "="}
        for act, c in plan:
            print("%s %-5s %-38s %-14s %s" % (
                marks[act], _age(c["ts"]), c["title"][:38], c["src"][:14], c["cwd"]))
        todo = sum(1 for act, _ in plan if act != "skip")
        print(f"\n{todo} sẽ gộp, {len(plan) - todo} bỏ qua (+ mới, ~ cập nhật, = đã có).")
        if not opt["apply"]:
            print("Chưa ghi gì. Thêm --apply để thực hiện.")
        elif todo:
            apply_sync(plan, dst)


def _sess_ts(f: Path, meta: dict) -> float:
    return (meta.get("lastActivityAt") or f.stat().st_mtime * 1000) / 1000


def plan_sync(cands, from_="", ids=(), update=False):
    plan = []
    for c in cands:
        if from_ and from_ != c["src"] and not c["src_uuid"].startswith(from_):
            continue
        if ids and not any(i and i in x for i in ids for x in c["ids"]):
            continue
        if c["dst_ts"] is None:
            plan.append(("copy", c))
        elif update and c["ts"] > c["dst_ts"]:
            plan.append(("update", c))
        else:
            plan.append(("skip", c))
    return plan


def apply_sync(plan, dst: Path) -> int:
    dst.mkdir(parents=True, exist_ok=True)
    n = 0
    for act, c in plan:
        if act != "skip":
            shutil.copy(c["path"], dst / c["name"])
            n += 1
    ok(f"Đã gộp {n} session vào tài khoản đang dùng")
    print("    Thoát hẳn Claude Desktop (⌘Q) rồi mở lại để thấy danh sách mới.")
    return n


