def normalize_codex_plan(s: str) -> str:
    """Chuẩn hoá tên gói dịch vụ Codex/ChatGPT (free, plus, pro, business, enterprise)."""
    s = (s or "").lower()
    if s in ("free", "go", "plus", "prolite", "pro"):
        return s.capitalize()
    if s in ("team", "self_serve_business_usage_based", "business"):
        return "Business"
    if s in ("enterprise", "enterprise_cbp_usage_based", "hc"):
        return "Enterprise"
    if s in ("education", "edu"):
        return "Edu"
    return s.capitalize() if s else "Unknown"


class CodexClient:
    """Quản lý tài khoản cho OpenAI Codex CLI, VS Code Extension và Codex App.
    
    Cơ chế quản lý lấy cảm hứng từ tool codex-auth:
    - Quản lý file ~/.codex/auth.json (hoặc $CODEX_HOME/auth.json)
    - Giải mã JWT để trích xuất email, account_id, user_id, plan_type
    - Hỗ trợ đổi tài khoản trước đó `switch -`
    - Hỗ trợ gán alias, export/import danh sách profile, login tự động
    """

    ID = "codex"
    NAME = "OpenAI Codex"

    def __init__(self):
        self.codex_home = Path(os.environ.get("CODEX_HOME") or HOME / ".codex")
        self.auth_file = self.codex_home / "auth.json"
        self.acc_dir = HOME / ".codex-accounts"
        self.backup_dir = self.acc_dir / "backups"
        self.export_dir = self.acc_dir / "export"
        self.state_file = self.acc_dir / ".last"
        self.prev_file = self.acc_dir / ".previous"

    def ensure_dirs(self):
        """Khởi tạo thư mục ~/.codex-accounts và backups với chmod 700."""
        self.acc_dir.mkdir(parents=True, exist_ok=True)
        self.backup_dir.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(self.acc_dir, 0o700)
            os.chmod(self.backup_dir, 0o700)
        except OSError:
            pass

    def profile_path(self, name: str) -> Path:
        """Đường dẫn tới file profile .json từ tên."""
        if not NAME_RE.match(name or ""):
            die(f"Tên không hợp lệ: '{name}' (chỉ cho phép chữ, số, . _ -)")
        return self.acc_dir / f"{name}.json"

    def profile_names(self) -> list:
        """Danh sách tên các profile Codex đã lưu."""
        if not self.acc_dir.exists():
            return []
        return sorted(
            p.stem for p in self.acc_dir.glob("*.json") if not p.name.startswith(".")
        )

    def load_auth_file(self) -> dict:
        """Đọc nội dung auth.json của Codex."""
        return load_json(self.auth_file)

    def parse_auth_info(self, auth_data: dict) -> dict:
        """Phân tích cấu trúc auth.json thành thông tin tài khoản hoàn chỉnh.
        
        Hỗ trợ các định dạng:
        1. API Key: OPENAI_API_KEY hoặc api_key có giá trị chuỗi.
        2. ChatGPT OAuth: tokens chứa id_token/access_token (JWT) và refresh_token.
        3. CPA / Proxy: id_token/access_token/account_id đặt trực tiếp ở root auth.json.
        """
        if not auth_data or not isinstance(auth_data, dict):
            return {}

        api_key = auth_data.get("OPENAI_API_KEY") or auth_data.get("api_key") or auth_data.get("apiKey")
        if isinstance(api_key, str) and api_key.strip():
            k = api_key.strip()
            masked = f"{k[:7]}...{k[-4:]}" if len(k) >= 12 else k[:4] + "..."
            key_hash = hashlib.sha256(k.encode()).hexdigest()[:8]
            return {
                "auth_mode": "apikey",
                "email": f"API Key ({masked})",
                "account_id": f"apikey-{key_hash}",
                "user_id": f"apikey-{key_hash}",
                "plan": "API",
                "account_name": "API Key",
                "last_refresh": auth_data.get("last_refresh"),
            }

        # Chế độ OAuth hoặc CPA proxy token
        tokens = auth_data.get("tokens") if isinstance(auth_data.get("tokens"), dict) else auth_data
        id_token = tokens.get("id_token") or auth_data.get("id_token") or ""
        access_token = tokens.get("access_token") or auth_data.get("access_token") or ""

        # Giải mã và hợp nhất thông tin từ cả 2 JWT payload (id_token và access_token)
        # Vì id_token thường chứa email/name (OIDC) còn access_token chứa claims https://api.openai.com/auth
        id_payload = parse_jwt_payload(id_token) if id_token else {}
        access_payload = parse_jwt_payload(access_token) if access_token else {}
        payload = {**access_payload, **id_payload}

        openai_auth = (
            id_payload.get("https://api.openai.com/auth")
            or access_payload.get("https://api.openai.com/auth")
            or payload.get("https://api.openai.com/auth")
            or {}
        )

        email = (
            payload.get("email")
            or auth_data.get("email")
            or tokens.get("email")
            or ""
        )
        account_id = (
            openai_auth.get("chatgpt_account_id")
            or tokens.get("account_id")
            or auth_data.get("account_id")
            or payload.get("chatgpt_account_id")
            or payload.get("account_id")
            or ""
        )
        user_id = (
            openai_auth.get("chatgpt_user_id")
            or payload.get("sub")
            or tokens.get("user_id")
            or auth_data.get("user_id")
            or ""
        )
        raw_plan = (
            openai_auth.get("plan_type")
            or payload.get("plan")
            or payload.get("plan_type")
            or auth_data.get("plan")
        )
        plan = normalize_codex_plan(raw_plan)

        # Kiểm tra tính hợp lệ: file phải chứa ít nhất token, key, email hoặc account_id
        if not (id_token or access_token or email or account_id):
            return {}

        return {
            "auth_mode": auth_data.get("auth_mode", "chatgpt"),
            "email": email or (f"acc-{account_id[:8]}" if account_id else "unknown"),
            "account_id": account_id or (email if email else "unknown"),
            "user_id": user_id,
            "plan": plan,
            "account_name": payload.get("name") or "",
            "last_refresh": auth_data.get("last_refresh"),
        }

    def current_auth_info(self) -> dict:
        """Thông tin tài khoản Codex đang đăng nhập."""
        data = self.load_auth_file()
        return self.parse_auth_info(data)

    def current_profile(self) -> str:
        """Xác định tên profile trùng khớp với tài khoản Codex đang active.
        
        Ưu tiên:
        1. Khớp chính xác account_id (tránh nhầm khi cùng email nhưng khác tổ chức/tài khoản).
        2. Khớp user_id.
        3. Khớp email.
        """
        info = self.current_auth_info()
        acc_id = info.get("account_id")
        email = info.get("email")
        if not acc_id and not email:
            return ""

        profiles = []
        for name in self.profile_names():
            p = load_json(self.profile_path(name))
            if p:
                profiles.append((name, p))

        # 1. Ưu tiên khớp chính xác account_id
        if acc_id:
            for name, p in profiles:
                if p.get("account_id") == acc_id:
                    return name

        # 2. Khớp user_id nếu có
        user_id = info.get("user_id")
        if user_id:
            for name, p in profiles:
                if p.get("user_id") == user_id:
                    return name

        # 3. Cuối cùng mới khớp email nếu không phân biệt được theo ID
        if email:
            for name, p in profiles:
                if (p.get("email") or "").lower() == email.lower():
                    return name

        return ""

    @contextlib.contextmanager
    def lock(self):
        """Khoá tránh ghi đè đồng thời giữa hai lệnh switch Codex."""
        self.ensure_dirs()
        if fcntl is None:
            yield
            return
        lock_file = self.acc_dir / ".lock"
        with open(lock_file, "w") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                die("đang có lệnh codex-switch khác chạy — thử lại sau vài giây")
            yield

    def backup_auth(self):
        """Sao lưu file ~/.codex/auth.json trước mỗi lần hoán đổi."""
        if not self.auth_file.exists():
            return
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        shutil.copy(self.auth_file, self.backup_dir / f"auth.json.{stamp}.{os.getpid()}")
        old = sorted(self.backup_dir.glob("auth.json.*"), key=lambda p: p.stat().st_mtime)
        for p in old[:-10]:
            try:
                p.unlink()
            except OSError:
                pass

    def name_from_info(self, info: dict) -> str:
        """Tự động suy ra tên profile từ email hoặc tên tài khoản."""
        email = info.get("email", "")
        if "@" in email:
            base = re.sub(r"[^A-Za-z0-9._-]", "-", email.split("@")[0])
            acc_id = info.get("account_id", "")
            out = self.profile_path(base)
            if out.exists():
                existing = load_json(out)
                if acc_id and existing.get("account_id") and existing.get("account_id") != acc_id:
                    return f"{base}-{acc_id[:4]}"
            return base
        acc_id = info.get("account_id", "")
        if acc_id:
            return f"codex-{acc_id[:8]}"
        return "codex-account"

    def resolve_profile_name(self, query: str) -> str:
        """Tìm tên profile khớp với truy vấn: tên profile, số thứ tự hàng, alias, email, account_id."""
        if not query:
            return ""
        names = self.profile_names()
        if not names:
            return ""

        # 1. Khớp chính xác tên profile hợp lệ (chỉ gọi profile_path khi query hợp lệ)
        if NAME_RE.match(query) and self.profile_path(query).exists():
            return query

        # 2. Khớp số thứ tự hàng (1-indexed row number từ list)
        if query.isdigit():
            idx = int(query)
            if 1 <= idx <= len(names):
                return names[idx - 1]

        q_lower = query.lower()
        profiles = []
        for name in names:
            p = load_json(self.profile_path(name))
            if p:
                profiles.append((name, p))

        # 3. Khớp chính xác alias
        for name, p in profiles:
            if (p.get("alias") or "").lower() == q_lower:
                return name

        # 4. Khớp chính xác email
        for name, p in profiles:
            if (p.get("email") or "").lower() == q_lower:
                return name

        # 5. Khớp chính xác account_id
        for name, p in profiles:
            if (p.get("account_id") or "").lower() == q_lower:
                return name

        # 6. Khớp tiền tố hoặc fragment
        for name, p in profiles:
            if name.lower().startswith(q_lower):
                return name
            alias = (p.get("alias") or "").lower()
            if alias and (alias.startswith(q_lower) or q_lower in alias):
                return name
            email = (p.get("email") or "").lower()
            if email and (email.startswith(q_lower) or q_lower in email):
                return name

        return ""

    def save(self, name: str = "", alias: str = "", quiet: bool = False):
        """Lưu auth.json hiện tại của Codex thành một profile."""
        if not self.auth_file.exists():
            die(f"chưa đăng nhập Codex (không tìm thấy {self.auth_file}). Chạy `codex login` trước.")
        raw_auth = self.load_auth_file()
        info = self.parse_auth_info(raw_auth)
        if not info:
            die(f"file {self.auth_file} không có thông tin xác thực hợp lệ")

        if not name:
            name = self.name_from_info(info)
            if not name:
                die("không suy ra được tên profile, truyền tên: codex-switch save <name>")

        out = self.profile_path(name)
        existing = load_json(out)
        saved_alias = alias or existing.get("alias")

        write_json(out, {
            "name": name,
            "alias": saved_alias,
            "email": info.get("email"),
            "account_id": info.get("account_id"),
            "user_id": info.get("user_id"),
            "plan": info.get("plan"),
            "auth_mode": info.get("auth_mode"),
            "account_name": info.get("account_name"),
            "credentials": raw_auth,
            "savedAt": int(time.time()),
        })
        if not quiet:
            ok(f"Đã lưu profile Codex '{name}'" + (f" (alias: {saved_alias})" if saved_alias else ""))

    def restart_daemon(self) -> bool:
        """Restart app-server daemon của Codex để nó nạp lại auth.json.

        Daemon sống sau khi đóng CLI/VS Code và giữ token cũ trong bộ nhớ, nên chỉ ghi
        auth.json thì mọi session qua daemon vẫn bị 401. Chỉ chạm daemon của chính $CODEX_HOME này.
        """
        if not (self.codex_home / "app-server-daemon").exists():
            return False
        try:
            r = subprocess.run(["codex", "app-server", "daemon", "restart"],
                               capture_output=True, timeout=30, env={**os.environ, "CODEX_HOME": str(self.codex_home)})
        except (OSError, subprocess.TimeoutExpired):
            return False
        return r.returncode == 0

    def use(self, query: str):
        """Chuyển sang một profile Codex."""
        if not query:
            die("Usage: codex-switch switch <name|alias|email>")
        name = self.resolve_profile_name(query)
        if not name:
            die(f"không tìm thấy profile Codex phù hợp với '{query}'. Xem: codex-switch list")

        src = self.profile_path(name)
        prof = load_json(src)
        creds = prof.get("credentials")
        if not creds:
            die(f"profile '{name}' không có credential hợp lệ")

        # Auto-save tài khoản Codex đang dùng nếu đã thay đổi
        cur = self.current_profile()
        if cur and cur != name:
            self.save(cur, quiet=True)
            print(f"[..] Đã cập nhật profile hiện tại: {cur}")
            self.prev_file.write_text(cur)
        elif not cur and self.auth_file.exists():
            print("[!] Tài khoản Codex đang đăng nhập chưa được lưu — sẽ mất truy cập nhanh tới nó.\n"
                  "    Huỷ (Ctrl-C) rồi chạy: codex-switch save <name>")

        self.backup_auth()
        write_json(self.auth_file, creds)
        self.state_file.write_text(name)

        ok(f"Đã chuyển sang tài khoản Codex '{name}'")
        if self.restart_daemon():
            print("    Đã restart app-server daemon của Codex — mở lại session để nhận tài khoản mới.")
            return
        n = process_count("codex")
        print(f"    Đang có {n} tiến trình codex chạy bằng token cũ — khởi động lại Codex CLI / VS Code / Codex App để nhận tài khoản mới."
              if n else "    Khởi động lại Codex client (CLI / VS Code / App) để áp dụng tài khoản mới.")

    def switch_prev(self):
        """Chuyển về tài khoản Codex trước đó (chức năng `codex-auth switch -`)."""
        if not self.prev_file.exists():
            die("Chưa ghi nhận tài khoản Codex trước đó để chuyển")
        prev = self.prev_file.read_text().strip()
        if not prev or not self.profile_path(prev).exists():
            die(f"Tài khoản trước đó '{prev}' không còn tồn tại")
        self.use(prev)

    def next(self):
        """Chuyển sang profile Codex tiếp theo theo vòng tròn alphabet."""
        names = self.profile_names()
        if not names:
            die("chưa có profile nào")
        last = self.current_profile() or (self.state_file.read_text().strip() if self.state_file.exists() else "")
        idx = names.index(last) if last in names else -1
        self.use(names[(idx + 1) % len(names)])

    def remove(self, *queries: str, all_profiles: bool = False):
        """Xoá profile Codex (một, nhiều profile, hoặc tất cả)."""
        if all_profiles or (queries and queries[0] == "--all"):
            names = self.profile_names()
            if not names:
                print("Không có profile nào để xoá.")
                return
            for n in names:
                self.profile_path(n).unlink(missing_ok=True)
            self.state_file.unlink(missing_ok=True)
            self.prev_file.unlink(missing_ok=True)
            ok(f"Đã xoá toàn bộ {len(names)} profile Codex")
            return

        if not queries:
            die("Usage: codex-switch remove <name|alias|email>... hoặc codex-switch remove --all")
        for q in queries:
            name = self.resolve_profile_name(q)
            if not name:
                die(f"không tìm thấy profile Codex '{q}'")
            self.profile_path(name).unlink(missing_ok=True)
            if self.state_file.exists() and self.state_file.read_text().strip() == name:
                self.state_file.unlink(missing_ok=True)
            if self.prev_file.exists() and self.prev_file.read_text().strip() == name:
                self.prev_file.unlink(missing_ok=True)
            ok(f"Đã xoá profile Codex '{name}'")

    def alias_set(self, query: str, alias: str):
        """Đặt alias cho profile Codex (tham khảo `codex-auth alias set`)."""
        if not query or not alias:
            die("Usage: codex-switch alias set <query> <alias>")
        if not NAME_RE.match(alias):
            die(f"Tên alias không hợp lệ: '{alias}'")
        name = self.resolve_profile_name(query)
        if not name:
            die(f"không tìm thấy profile Codex '{query}'")
        p = load_json(self.profile_path(name))
        p["alias"] = alias
        write_json(self.profile_path(name), p)
        ok(f"Đã gán alias '{alias}' cho profile '{name}'")

    def alias_clear(self, query: str):
        """Xoá alias của profile Codex (tham khảo `codex-auth alias clear`)."""
        if not query:
            die("Usage: codex-switch alias clear <query>")
        name = self.resolve_profile_name(query)
        if not name:
            die(f"không tìm thấy profile Codex '{query}'")
        p = load_json(self.profile_path(name))
        p["alias"] = None
        write_json(self.profile_path(name), p)
        ok(f"Đã xoá alias của profile '{name}'")

    def login(self, device_auth: bool = False):
        """Gọi `codex login` rồi tự động lưu tài khoản (tham khảo `codex-auth login`)."""
        cmd = ["codex", "login"]
        if device_auth:
            cmd.append("--device-auth")
        print(f"[*] Thực thi: {' '.join(cmd)}")
        try:
            r = subprocess.run(cmd)
            if r.returncode != 0:
                die(f"codex login thất bại với mã thoát {r.returncode}")
        except FileNotFoundError:
            die("không tìm thấy lệnh `codex` trong PATH. Cài đặt bằng: npm install -g @openai/codex")
        # Đọc kết quả và lưu profile
        self.save()

    def export(self, dir_path: str = ""):
        """Xuất các credential thành file auth.json (tham khảo `codex-auth export`)."""
        out_dir = Path(dir_path) if dir_path else self.export_dir
        out_dir.mkdir(parents=True, exist_ok=True)
        names = self.profile_names()
        if not names:
            print("Không có profile nào để xuất.")
            return
        count = 0
        for n in names:
            p = load_json(self.profile_path(n))
            creds = p.get("credentials")
            if creds:
                target = out_dir / f"{n}.auth.json"
                write_json(target, creds)
                count += 1
        ok(f"Đã xuất {count} profile Codex vào {out_dir}")

    def import_auth(self, target_path: str):
        """Nhập profile từ file hoặc thư mục *.auth.json (tham khảo `codex-auth import`)."""
        if not target_path:
            die("Usage: codex-switch import <file|dir>")
        p = Path(target_path)
        if not p.exists():
            die(f"đường dẫn không tồn tại: {target_path}")

        files = list(p.glob("*.json")) if p.is_dir() else [p]
        imported = 0
        for f in files:
            data = load_json(f)
            info = self.parse_auth_info(data)
            if not info:
                continue
            name = f.stem.replace(".auth", "")
            if not NAME_RE.match(name):
                name = self.name_from_info(info)
            write_json(self.profile_path(name), {
                "name": name,
                "alias": None,
                "email": info.get("email"),
                "account_id": info.get("account_id"),
                "user_id": info.get("user_id"),
                "plan": info.get("plan"),
                "auth_mode": info.get("auth_mode"),
                "credentials": data,
                "savedAt": int(time.time()),
            })
            imported += 1
        if p.is_file() and imported == 0:
            die(f"file '{target_path}' không chứa thông tin xác thực Codex hợp lệ")
        ok(f"Đã nhập thành công {imported} profile Codex")

    def load_rows(self) -> list:
        """Nạp danh sách thông tin hiển thị các profile Codex."""
        cur = self.current_profile()
        rows = []
        for n in self.profile_names():
            p = load_json(self.acc_dir / f"{n}.json")
            if not p:
                continue
            rows.append({
                "name": n,
                "cur": n == cur,
                "alias": p.get("alias") or "",
                "email": p.get("email") or "?",
                "plan": p.get("plan") or "Unknown",
                "auth_mode": p.get("auth_mode") or "chatgpt",
                "saved": p.get("savedAt"),
            })
        return rows

    def list(self):
        """Liệt kê các profile Codex."""
        rows = self.load_rows()
        if not rows:
            print("Chưa có profile Codex nào. Lưu tài khoản hiện tại: codex-switch save <name>")
            return
        print("%-2s %-14s %-12s %-30s %-10s %s" % ("", "PROFILE", "ALIAS", "EMAIL", "PLAN", "AUTH"))
        for r in rows:
            mark = "*" if r["cur"] else " "
            print("%-2s %-14s %-12s %-30s %-10s %s" % (
                mark, r["name"], r["alias"], r["email"], r["plan"], r["auth_mode"]))

    def status(self):
        """Xem tài khoản Codex đang đăng nhập."""
        cur = self.current_profile()
        info = self.current_auth_info()
        if cur:
            alias_str = f" (alias: {load_json(self.profile_path(cur)).get('alias')})" if load_json(self.profile_path(cur)).get("alias") else ""
            ok(f"Đang dùng: {cur}{alias_str} · {info.get('email')} [{info.get('plan')}]")
        elif info.get("email"):
            print(f"[?] Đang đăng nhập tài khoản Codex chưa lưu: {info.get('email')} [{info.get('plan')}]")
        else:
            print("[?] Chưa đăng nhập Codex")

    def doctor(self):
        """Kiểm tra sức khoẻ cấu hình Codex."""
        bad = 0

        def line(level, msg):
            nonlocal bad
            print({"ok": "[OK]   ", "warn": "[!]    ", "err": "[ERROR]"}[level], msg)
            bad += level == "err"

        if os.environ.get("OPENAI_API_KEY"):
            line("warn", "biến OPENAI_API_KEY đang đặt — nó có thể ghi đè token trong auth.json")
        line("ok" if self.auth_file.exists() else "warn",
             f"auth file: {self.auth_file}" + (" (tồn tại)" if self.auth_file.exists() else " (chưa có — cần đăng nhập)"))
        if self.acc_dir.exists() and (self.acc_dir.stat().st_mode & 0o077):
            line("err", f"{self.acc_dir} cho phép nhóm/người khác truy cập — chạy: chmod 700 {self.acc_dir}")

        acc_ids = {}
        for n in self.profile_names():
            f = self.acc_dir / f"{n}.json"
            if f.stat().st_mode & 0o077:
                line("err", f"profile '{n}' chứa credential nhưng không phải chmod 600")
            try:
                p = json.loads(f.read_text())
                assert p.get("credentials")
            except Exception:
                line("err", f"profile '{n}' hỏng hoặc thiếu trường")
                continue
            aid = p.get("account_id") or p.get("email")
            if aid:
                acc_ids.setdefault(aid, []).append(n)

        for names in acc_ids.values():
            if len(names) > 1:
                line("warn", f"các profile {', '.join(names)} là cùng một tài khoản Codex")

        n = process_count("codex")
        if n:
            line("ok", f"{n} tiến trình codex đang chạy (khởi động lại sau khi switch)")

        print("\nKhông phát hiện lỗi Codex." if not bad else f"\n{bad} lỗi Codex cần sửa.")
        sys.exit(1 if bad else 0)


