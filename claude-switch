#!/usr/bin/env python3
"""claude-switch — Claude Code Multi-Account Switcher.

Chuyển đổi giữa nhiều tài khoản Claude Code (subscription OAuth) mà không phải
đăng nhập lại. Chỉ hoán đổi ĐÚNG phần credential + danh tính của tài khoản:

  - OAuth token : macOS Keychain (service "Claude Code-credentials")
                  hoặc ~/.claude/.credentials.json (Linux / Windows / macOS cấu hình file)
  - Danh tính   : 2 key `oauthAccount` + `userID` trong ~/.claude.json

KHÔNG đụng tới ~/.claude/ (settings.json, CLAUDE.md, hooks, plugins, projects)
và không đụng các key khác trong ~/.claude.json (mcpServers, projects, ...).
Hệ quả: mọi tài khoản dùng chung lịch sử hội thoại + cấu hình, và switch chỉ tốn
vài KB thay vì copy hàng trăm MB.

Ngoại lệ duy nhất là sidebar của Claude Desktop — xem `sync_sessions`.

Usage: claude-switch help
"""
import contextlib
import io
import json
import locale
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

try:
    import fcntl
except ImportError:  # Windows: không có khoá file, bỏ qua
    fcntl = None
try:
    import curses
except ImportError:  # Windows không có curses: CLI vẫn chạy, chỉ TUI tắt
    curses = None

os.umask(0o077)  # mọi file tạo ra mặc định 600 — profile chứa refresh token

# --- Đường dẫn (đều derive từ $HOME để test có thể override bằng HOME=<tmp>) ---
HOME = Path.home()
ACC_DIR = HOME / ".claude-accounts"        # kho profile, chmod 700
BACKUP_DIR = ACC_DIR / "backups"           # bản sao ~/.claude.json trước mỗi lần ghi
STATE_FILE = ACC_DIR / ".last"             # profile dùng gần nhất (cho lệnh `next`)
CONFIG = HOME / ".claude.json"             # config gốc của Claude Code
CREDS_FILE = HOME / ".claude" / ".credentials.json"
KC_SERVICE = "Claude Code-credentials"     # tên service trong macOS Keychain


def _sess_default() -> Path:
    """Thư mục userData của Claude Desktop (Electron), khác nhau theo OS."""
    if sys.platform == "darwin":
        return HOME / "Library/Application Support/Claude/claude-code-sessions"
    if os.name == "nt":
        base = Path(os.environ.get("APPDATA") or HOME / "AppData/Roaming")
        return base / "Claude/claude-code-sessions"
    base = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
    return base / "Claude/claude-code-sessions"


# Override khi cài Desktop ở chỗ khác (và để test chạy được trên mọi OS).
SESS_DIR = Path(os.environ.get("CLAUDE_SESSIONS_DIR") or _sess_default())

NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")

# Đọc từ file VERSION cạnh script (theo symlink về repo) thay vì hằng số trong code —
# một chỗ duy nhất để sửa khi phát hành.
VERSION_FILE = Path(__file__).resolve().parent / "VERSION"
VERSION = VERSION_FILE.read_text().strip() if VERSION_FILE.exists() else "?"


def die(msg: str):
    print(f"[ERROR] {msg}", file=sys.stderr)
    sys.exit(1)


def ok(msg: str):
    print(f"[OK] {msg}")


def profile_path(name: str) -> Path:
    # Chặn path traversal: tên profile được ghép thẳng vào ACC_DIR.
    if not NAME_RE.match(name or ""):
        die(f"Tên không hợp lệ: '{name}' (chỉ cho phép chữ, số, . _ -)")
    return ACC_DIR / f"{name}.json"


def profile_names():
    return sorted(
        p.stem for p in ACC_DIR.glob("*.json") if not p.name.startswith(".")
    )


def write_json(path: Path, data):
    """Ghi JSON 600, atomic — không để lại file hỏng nếu bị kill giữa chừng."""
    tmp = path.with_suffix(path.suffix + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def load_config() -> dict:
    try:
        return json.loads(CONFIG.read_text())
    except Exception:
        return {}


# --- Credential backend: file nếu tồn tại, ngược lại Keychain trên macOS ---
def use_file_backend() -> bool:
    return CREDS_FILE.exists() or sys.platform != "darwin"


def read_creds() -> str:
    if use_file_backend():
        return CREDS_FILE.read_text() if CREDS_FILE.exists() else ""
    r = subprocess.run(
        ["security", "find-generic-password", "-a", os.environ.get("USER", ""),
         "-s", KC_SERVICE, "-w"],
        capture_output=True, text=True,
    )
    return r.stdout.strip() if r.returncode == 0 else ""


def write_creds(blob: str):
    if not blob:
        die("credential rỗng, không ghi")
    if use_file_backend():
        CREDS_FILE.parent.mkdir(parents=True, exist_ok=True)
        CREDS_FILE.write_text(blob)
        os.chmod(CREDS_FILE, 0o600)
        return
    # ponytail: blob đi qua argv nên lộ trong `ps` khoảng vài ms. `security` không
    # nhận secret qua stdin ở chế độ non-interactive. Nâng cấp: gọi Security.framework
    # qua Swift/ObjC nếu chạy trên máy nhiều người dùng.
    r = subprocess.run(
        ["security", "add-generic-password", "-U", "-a", os.environ.get("USER", ""),
         "-s", KC_SERVICE, "-w", blob],
        capture_output=True,
    )
    if r.returncode != 0:
        die("không ghi được Keychain")


def current_uuid() -> str:
    return load_config().get("oauthAccount", {}).get("accountUuid") or ""


def current_org() -> str:
    return load_config().get("oauthAccount", {}).get("organizationUuid") or ""


def current_profile() -> str:
    """Tên profile trùng accountUuid đang active.

    Nhận diện bằng UUID chứ không so sánh nội dung file — ~/.claude.json thay đổi
    liên tục (numStartups, các cache) nên so sánh file luôn cho kết quả sai.
    """
    uuid = current_uuid()
    if not uuid:
        return ""
    for name in profile_names():
        try:
            prof = json.loads((ACC_DIR / f"{name}.json").read_text())
        except Exception:
            continue
        if prof.get("oauthAccount", {}).get("accountUuid") == uuid:
            return name
    return ""


@contextlib.contextmanager
def lock():
    """Một lệnh ghi tại một thời điểm — hai lệnh switch chạy chồng sẽ ghi đè credential của nhau."""
    if fcntl is None:
        yield
        return
    with open(ACC_DIR / ".lock", "w") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            die("đang có lệnh claude-switch khác chạy — thử lại sau vài giây")
        yield


def claude_running() -> int:
    """Số tiến trình `claude` đang chạy; 0 nếu máy không có pgrep."""
    try:
        r = subprocess.run(["pgrep", "-x", "claude"], capture_output=True, text=True)
    except OSError:
        return 0
    return len(r.stdout.split())


def backup_config():
    """Giữ 10 bản gần nhất của ~/.claude.json — file duy nhất bị ghi đè."""
    if not CONFIG.exists():
        return
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    shutil.copy(CONFIG, BACKUP_DIR / f"claude.json.{stamp}.{os.getpid()}")
    old = sorted(BACKUP_DIR.glob("claude.json.*"), key=lambda p: p.stat().st_mtime)
    for p in old[:-10]:
        p.unlink()


def name_from_email(cfg: dict) -> str:
    email = cfg.get("oauthAccount", {}).get("emailAddress", "")
    return re.sub(r"[^A-Za-z0-9._-]", "-", email.split("@")[0]) if email else ""


# --- save: snapshot tài khoản đang active thành profile ---
def cmd_save(name: str = "", quiet: bool = False):
    creds = read_creds()
    if not creds:
        die("chưa đăng nhập (không tìm thấy credential). Chạy `claude` và đăng nhập trước.")
    if not CONFIG.exists():
        die(f"không tìm thấy {CONFIG}")
    cfg = load_config()

    # Không có tên → lấy phần trước @ của email làm tên profile.
    if not name:
        name = name_from_email(cfg)
        if not name:
            die("không suy ra được tên từ email, truyền tên: claude-switch save <name>")

    out = profile_path(name)
    write_json(out, {
        "credentials": json.loads(creds),
        "oauthAccount": cfg.get("oauthAccount", {}),
        "userID": cfg.get("userID"),
        # snapshot % quota tại thời điểm save — dùng cho lệnh `usage`, tránh phải
        # đăng nhập từng account rồi scrape TUI chỉ để xem còn bao nhiêu quota.
        "usage": cfg.get("cachedUsageUtilization"),
        "savedAt": int(time.time()),
    })
    if not quiet:
        ok(f"Đã lưu profile '{name}'")


# --- use: nạp profile vào Claude Code ---
def cmd_use(name: str):
    if not name:
        die("Usage: claude-switch use <name>")
    src = profile_path(name)
    if not src.exists():
        die(f"không có profile '{name}'. Xem: claude-switch list")
    prof = json.loads(src.read_text())

    # Auto-save tài khoản đang active trước khi rời đi: refresh token có thể đã được
    # Claude Code xoay vòng, và snapshot quota cần cập nhật.
    cur = current_profile()
    if cur and cur != name:
        cmd_save(cur, quiet=True)
        print(f"[..] Đã cập nhật profile hiện tại: {cur}")
    elif not cur and current_uuid():
        print("[!] Tài khoản đang đăng nhập chưa được lưu — sẽ mất truy cập nhanh tới nó.\n"
              "    Huỷ (Ctrl-C) rồi chạy: claude-switch save <name>")

    backup_config()
    cfg = load_config()
    # Chỉ ghi đè 2 key định danh. Mọi key khác (mcpServers, projects, settings, cache)
    # thuộc về máy chứ không thuộc về tài khoản → giữ nguyên.
    cfg["oauthAccount"] = prof["oauthAccount"]
    cfg["userID"] = prof["userID"]
    cfg.pop("cachedUsageUtilization", None)  # cache của account cũ, để Claude tự fetch lại
    write_json(CONFIG, cfg)

    write_creds(json.dumps(prof["credentials"]))
    STATE_FILE.write_text(name)
    ok(f"Đã chuyển sang '{name}'")
    n = claude_running()
    print(f"    Đang có {n} tiến trình claude chạy bằng token cũ — thoát hẳn rồi mở lại." if n
          else "    Mở Claude Code để dùng tài khoản mới.")


# --- list / status / usage ---
def cmd_list():
    rows = load_rows()
    if not rows:
        print("Chưa có profile nào. Lưu tài khoản hiện tại: claude-switch save <name>")
        return
    for r in rows:
        print("%s %-14s %-32s %s" % ("*" if r["cur"] else " ", r["name"], r["email"], r["org"]))


def cmd_status():
    cur = current_profile()
    if cur:
        ok(f"Đang dùng: {cur}")
    elif current_uuid():
        print("[?] Đang đăng nhập một tài khoản chưa được lưu thành profile")
    else:
        print("[?] Chưa đăng nhập")


def cmd_usage():
    rows = load_rows()
    if not rows:
        print("Chưa có profile nào.")
        return

    def pct(u, key):
        b = u.get(key)
        if not b:
            return "  ?  ", ""
        resets = b.get("resets_at") or ""
        if resets:
            try:
                resets = "reset " + datetime.fromisoformat(resets).astimezone().strftime("%d/%m %H:%M")
            except Exception:
                pass
        return "%3d%%" % b.get("utilization", 0), resets

    print("%-14s %-28s %-6s %-6s %-6s %s" % ("PROFILE", "EMAIL", "5H", "7D", "NGUỒN", ""))
    for r in rows:
        h5, _ = pct(r["usage"], "five_hour")
        d7, r7 = pct(r["usage"], "seven_day")
        print("%-14s %-28s %-6s %-6s %-6s %s" % (
            r["name"], r["email"], h5, d7, "live" if r["live"] else _age(r["saved"]), r7))
    print("\nlive = tài khoản đang dùng, đọc từ ~/.claude.json. Còn lại là snapshot lúc profile")
    print("được lưu (tự cập nhật mỗi lần switch). Số realtime: claude  →  /usage")


def cmd_next():
    names = profile_names()
    if not names:
        die("chưa có profile nào")
    last = current_profile() or (STATE_FILE.read_text() if STATE_FILE.exists() else "")
    idx = names.index(last) if last in names else -1
    cmd_use(names[(idx + 1) % len(names)])


def cmd_remove(name: str):
    if not name:
        die("Usage: claude-switch remove <name>")
    f = profile_path(name)
    if not f.exists():
        die(f"không có profile '{name}'")
    f.unlink()
    ok(f"Đã xoá profile '{name}' (tài khoản trên server không bị ảnh hưởng)")


def cmd_doctor():
    bad = 0

    def line(level, msg):
        nonlocal bad
        print({"ok": "[OK]   ", "warn": "[!]    ", "err": "[ERROR]"}[level], msg)
        bad += level == "err"

    for v in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN"):
        if os.environ.get(v):
            line("warn", f"biến {v} đang đặt — nó ưu tiên hơn credential đã đăng nhập, "
                         "nên switch không có tác dụng trong shell này")
    line("ok", "credential: " + ("file " + str(CREDS_FILE) if use_file_backend() else "macOS Keychain"))
    if not read_creds():
        line("warn", "chưa đăng nhập (không có credential)")
    if ACC_DIR.stat().st_mode & 0o077:
        line("err", f"{ACC_DIR} cho phép nhóm/người khác truy cập — chạy: chmod 700 {ACC_DIR}")

    uuids = {}
    for n in profile_names():
        f = ACC_DIR / f"{n}.json"
        if f.stat().st_mode & 0o077:
            line("err", f"profile '{n}' chứa refresh token nhưng không phải chmod 600")
        try:
            p = json.loads(f.read_text())
            u = p["oauthAccount"]["accountUuid"]
            assert p["credentials"] and p["userID"]
        except Exception:
            line("err", f"profile '{n}' hỏng hoặc thiếu trường — lưu lại: claude-switch save {n}")
            continue
        uuids.setdefault(u, []).append(n)
    for names in uuids.values():
        if len(names) > 1:
            line("warn", f"các profile {', '.join(names)} là cùng một tài khoản")
    if current_uuid() and not current_profile():
        line("warn", "tài khoản đang đăng nhập chưa được lưu thành profile")
    n = claude_running()
    if n:
        line("ok", f"{n} tiến trình claude đang chạy (giữ token cũ nếu bạn vừa switch)")
    line("ok" if SESS_DIR.is_dir() else "warn",
         f"Claude Desktop sessions: {SESS_DIR}" + ("" if SESS_DIR.is_dir() else " (chưa có — bỏ qua nếu không dùng Desktop)"))
    print("\nKhông phát hiện lỗi." if not bad else f"\n{bad} lỗi cần sửa.")
    sys.exit(1 if bad else 0)


# --- sync-sessions: gộp danh sách session của Desktop về tài khoản đang dùng ---
def account_labels() -> dict:
    """accountUuid -> tên profile, để gắn nhãn nguồn cho session."""
    out = {}
    for n in profile_names():
        try:
            out[json.loads((ACC_DIR / f"{n}.json").read_text())["oauthAccount"]["accountUuid"]] = n
        except Exception:
            pass
    return out


def _sess_ts(f: Path, meta: dict) -> float:
    """Thời điểm hoạt động cuối (giây). lastActivityAt là epoch mili-giây."""
    return (meta.get("lastActivityAt") or f.stat().st_mtime * 1000) / 1000


def session_candidates():
    """(thư mục đích, session nằm ở thư mục <account>/<org> khác đích), mới nhất trước.

    Nội dung hội thoại nằm ở ~/.claude/projects (dùng chung, switch không đụng tới),
    nhưng Desktop chỉ đọc ĐÚNG MỘT thư mục <accountUuid>/<orgUuid> của account+org đang
    đăng nhập → đổi account là danh sách trống. Phải đổi cả orgUuid khi copy, không giữ
    org gốc: giữ nguyên thì file nằm ở thư mục Desktop không bao giờ đọc tới.
    """
    uuid, org = current_uuid(), current_org()
    if not uuid or not org:
        die("chưa đăng nhập, không biết gộp về đâu")
    if not SESS_DIR.is_dir():
        die(f"không có {SESS_DIR} — Claude Desktop chưa chạy lần nào? "
            "Đường dẫn khác thì đặt CLAUDE_SESSIONS_DIR")
    dst, labels, out = SESS_DIR / uuid / org, account_labels(), []
    for src in sorted(SESS_DIR.glob("*/*")):
        if not src.is_dir() or src == dst:
            continue
        for f in sorted(src.glob("local_*.json")):  # bỏ deleted_*, scheduled-tasks.json
            try:
                meta = json.loads(f.read_text())
            except Exception:
                meta = {}
            d = dst / f.name
            out.append({
                "path": f, "name": f.name, "src_uuid": src.parent.name,
                "src": labels.get(src.parent.name, src.parent.name[:8]),
                "ids": [f.stem, meta.get("cliSessionId") or ""],
                "title": meta.get("title") or "(không tên)", "cwd": meta.get("cwd") or "",
                "ts": _sess_ts(f, meta),
                "dst_ts": _sess_ts(d, _load_json(d)) if d.exists() else None,
            })
    out.sort(key=lambda x: -x["ts"])
    return dst, out


def _load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text())
    except Exception:
        return {}


def plan_sync(cands, from_="", ids=(), update=False):
    """Mỗi session → (hành động, session): copy | update | skip.

    Mặc định không ghi đè bản ở đích (nó mới hơn: lastFocusedAt, title đã sửa);
    --update chỉ ghi đè khi bản nguồn có hoạt động mới hơn.
    """
    plan = []
    for c in cands:
        if from_ and from_ != c["src"] and not c["src_uuid"].startswith(from_):
            continue
        if ids and not any(i and i in x for i in ids for x in c["ids"]):
            continue
        if c["dst_ts"] is None:
            plan.append(("copy", c))
        elif update and c["ts"] > c["dst_ts"]:
            plan.append(("update", c))
        else:
            plan.append(("skip", c))
    return plan


def apply_sync(plan, dst: Path) -> int:
    dst.mkdir(parents=True, exist_ok=True)
    n = 0
    for act, c in plan:
        if act != "skip":
            shutil.copy(c["path"], dst / c["name"])
            n += 1
    ok(f"Đã gộp {n} session vào tài khoản đang dùng")
    print("    Thoát hẳn Claude Desktop (⌘Q) rồi mở lại để thấy danh sách mới.")
    return n


def cmd_sync_sessions(args=()):
    opt = {"apply": False, "update": False, "from": "", "ids": []}
    it = iter(args)
    for a in it:
        if a in ("--apply", "--update"):
            opt[a[2:]] = True
        elif a in ("--from", "--session"):
            v = next(it, "")
            if not v:
                die(f"{a} cần một giá trị. Xem: claude-switch help")
            if a == "--from":
                opt["from"] = v
            else:
                opt["ids"].append(v)
        else:
            die(f"tuỳ chọn không hợp lệ: {a}. Xem: claude-switch help")

    dst, cands = session_candidates()
    plan = plan_sync(cands, opt["from"], opt["ids"], opt["update"])
    marks = {"copy": "+", "update": "~", "skip": "="}
    for act, c in plan:
        print("%s %-5s %-38s %-14s %s" % (
            marks[act], _age(c["ts"]), c["title"][:38], c["src"][:14], c["cwd"]))
    todo = sum(1 for act, _ in plan if act != "skip")
    print(f"\n{todo} sẽ gộp, {len(plan) - todo} bỏ qua (+ mới, ~ cập nhật, = đã có).")
    if not opt["apply"]:
        print("Chưa ghi gì. Thêm --apply để thực hiện.")
    elif todo:
        apply_sync(plan, dst)


