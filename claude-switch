Profile lưu ở ~/.claude-accounts (chmod 700, file 600) và CHỨA REFRESH TOKEN —
đừng commit hay sync thư mục này lên cloud.

Sau khi switch phải thoát và mở lại Claude Code; phiên đang chạy giữ token trong RAM.""")


READ_ONLY = {"ui", "list", "ls", "status", "current", "usage", "doctor",
             "version", "-v", "--version", "help", "-h", "--help"}


def dispatch(cmd, args, arg):
    if cmd == "ui":
        cmd_ui()
    elif cmd == "save":
        cmd_save(arg)
    elif cmd == "use":
        cmd_use(arg)
    elif cmd in ("list", "ls"):
        cmd_list()
    elif cmd in ("status", "current"):
        cmd_status()
    elif cmd == "usage":
        cmd_usage()
    elif cmd == "doctor":
        cmd_doctor()
    elif cmd == "next":
        cmd_next()
    elif cmd in ("remove", "rm"):
        cmd_remove(arg)
    elif cmd == "sync-sessions":
        cmd_sync_sessions(args)
    elif cmd in ("version", "-v", "--version"):
        print(VERSION)
    elif cmd in ("help", "-h", "--help"):
        cmd_help()
    else:
        cmd_use(cmd)  # `claude-switch work` = `claude-switch use work`


def main():
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(ACC_DIR, 0o700)
    os.chmod(BACKUP_DIR, 0o700)

    # Không đối số: TUI nếu có terminal, ngược lại (pipe, script) in help như trước.
    argv = sys.argv[1:] or (["ui"] if sys.stdin.isatty() and sys.stdout.isatty() and curses else ["help"])
    cmd, args = argv[0], argv[1:]
    arg = args[0] if args else ""

    if cmd in READ_ONLY:
        dispatch(cmd, args, arg)
    else:
        with lock():
            dispatch(cmd, args, arg)


if __name__ == "__main__":
    main()
